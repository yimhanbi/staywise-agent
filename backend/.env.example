# Local PostgreSQL configured by docker-compose.yml
DATABASE_URL=postgresql://user:password@localhost:5432/staywise

# Optional external services; fill in locally when using each feature.
DATA_GO_KR_SERVICE_KEY=replace_with_korea_tourism_api_key
KAKAO_REST_API_KEY=replace_with_kakao_rest_api_key
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Keep the matching test secret key on the backend only.
TOSS_SECRET_KEY=test_sk_replace_with_your_toss_secret_key
SESSION_SECRET=replace_with_a_long_random_secret
# Set to true when serving the frontend over HTTPS.
SESSION_COOKIE_SECURE=false
